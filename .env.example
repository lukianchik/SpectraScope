DATABASE_URL=postgresql+psycopg2://spectrascope:spectrascope@postgres:5432/spectrascope
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SERVICE_NAME=spectrascope-backend
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_ENV=dev
LAB_MODE=false
ENABLE_REAL_SCANNERS=false
ENABLE_NMAP=false
SCANNER_TIMEOUT_SECONDS=60
NUCLEI_TEMPLATES_PATH=./lab/nuclei-templates
ALLOWED_TARGET_DOMAINS=
ALLOWED_LAB_TARGETS=admin.lab.local:8088,legacy.lab.local:8088,files.lab.local:8088
CELERY_TASK_ALWAYS_EAGER=false
