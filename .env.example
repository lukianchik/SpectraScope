DATABASE_URL=postgresql+psycopg2://spectrascope:spectrascope@postgres:5432/spectrascope
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

SERVICE_NAME=spectrascope-backend
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_ENV=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUIRED=false
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
INTEGRATION_SECRET_KEY=local-development-integration-key-change-me

LAB_MODE=false
ENABLE_REAL_SCANNERS=false
ALLOW_BENCHMARK_DNS_PROXY=false
LOCAL_REAL_SCANNERS=false
ENABLE_NMAP=false
SCANNER_TIMEOUT_SECONDS=60
SCAN_STALE_AFTER_SECONDS=1800
SCANNER_MAX_RESULTS=200
NUCLEI_TEMPLATES_PATH=
ALLOWED_TARGET_DOMAINS=
ALLOWED_LAB_TARGETS=admin.lab.local:8088,legacy.lab.local:8088,files.lab.local:8088
LOCAL_REAL_SCOPE_TARGET=perimeter.lab.local:8088

CELERY_TASK_ALWAYS_EAGER=false

VITE_API_BASE_URL=
VITE_DEMO_MODE=false
