{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "rg *": "allow",
      "pytest *": "allow",
      "bun run*": "allow",
      "git push*": "deny",
      "docker compose down -v*": "deny"
    },
    "skill": {
      "*": "allow"
    }
  },
  "provider": {
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen2.5-coder-1.5b": {
          "name": "Qwen2.5-Coder 1.5B Q4_K_M",
          "limit": {
            "context": 16384,
            "output": 1024
          }
        }
      }
    }
  }
}
