# Copy to .env only for a controlled deployment and replace every CHANGE_ME value.
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=https://spectrascope.example.com
AUTH_REQUIRED=true
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=CHANGE_ME_RUN_PYTHON_SCRIPTS_GENERATE_PASSWORD_HASH_PY
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true
INTEGRATION_SECRET_KEY=CHANGE_ME_LONG_RANDOM_INTEGRATION_KEY_AT_LEAST_32_CHARACTERS

POSTGRES_DB=spectrascope
POSTGRES_USER=spectrascope
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg2://spectrascope:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/spectrascope

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

ENABLE_REAL_SCANNERS=false
ALLOW_BENCHMARK_DNS_PROXY=false
LOCAL_REAL_SCANNERS=false
ENABLE_NMAP=false
LAB_MODE=false
SCANNER_TIMEOUT_SECONDS=60
SCAN_STALE_AFTER_SECONDS=1800
SCANNER_MAX_RESULTS=200
NUCLEI_TEMPLATES_PATH=
ALLOWED_TARGET_DOMAINS=
ALLOWED_LAB_TARGETS=
LOCAL_REAL_SCOPE_TARGET=perimeter.lab.local:8088

# Keep the frontend same-origin in production. Demo data is opt-in only.
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
