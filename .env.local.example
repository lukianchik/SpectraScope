DATABASE_URL=sqlite:///./spectrascope.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SERVICE_NAME=spectrascope-backend
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_ENV=local
LAB_MODE=false
ENABLE_REAL_SCANNERS=false
ENABLE_NMAP=false
SCANNER_TIMEOUT_SECONDS=30
ALLOWED_TARGET_DOMAINS=
ALLOWED_LAB_TARGETS=admin.lab.local:8088,legacy.lab.local:8088,files.lab.local:8088
CELERY_TASK_ALWAYS_EAGER=true
