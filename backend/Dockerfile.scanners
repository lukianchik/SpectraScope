FROM golang:1.26-bookworm AS scanner-builder

ENV GOBIN=/out

ARG SUBFINDER_VERSION=v2.15.0
ARG HTTPX_VERSION=v1.7.3
ARG NUCLEI_VERSION=v3.11.1

RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@${SUBFINDER_VERSION}
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/projectdiscovery/httpx/cmd/httpx@${HTTPX_VERSION}
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@${NUCLEI_VERSION}

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt .
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nmap \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt

COPY --from=scanner-builder /out/subfinder /usr/local/bin/subfinder
COPY --from=scanner-builder /out/httpx /usr/local/bin/httpx
COPY --from=scanner-builder /out/nuclei /usr/local/bin/nuclei
COPY scanner-templates /opt/spectrascope/templates

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .

RUN addgroup --system spectrascope \
    && adduser --system --ingroup spectrascope --home /app spectrascope \
    && chown -R spectrascope:spectrascope /app

USER spectrascope

EXPOSE 8000
